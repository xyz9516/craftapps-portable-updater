+/// Explicit data directory for the community portable launcher across upgrades.
+fn resolve_override(dir: &Path) -> Portable {
+    match ensure_writable(dir) {
+        Ok(()) => Portable { dir: Some(dir.to_path_buf()), unwritable: None },
+        Err(error) => Portable { dir: None, unwritable: Some(Unwritable {
+            marker: PathBuf::from("PDFCRAFT_CONFIG_DIR"), folder: dir.to_path_buf(), error: error.to_string(),
+        }) },
+    }
